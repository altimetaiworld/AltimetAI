# .env.example
FLASK_APP=app.py
FLASK_DEBUG=False
SECRET_KEY=your_production_secret_key_here
PORT=5000

# Resend API Configuration (Free 3,000 emails/month)
RESEND_API_KEY=your_resend_api_key_here

# Email Senders & Notification Receivers
SMTP_FROM=Altimet AI <hello@altimetai.com>
NOTIFICATION_RECEIVER=hello@altimetai.com

# Optional: Fallback SMTP Configuration (e.g. Gmail / Brevo)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=hello@altimetai.com
# SMTP_PASSWORD=your_email_app_password
# SMTP_USE_TLS=True
